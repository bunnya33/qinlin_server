# Run `go run ./cmd/qinlin init` to generate real secrets in .env.
QINLIN_ADDR=127.0.0.1:8080
# HTTP and HTTPS origins are accepted, including a direct server IP and port.
QINLIN_PUBLIC_URL=http://localhost:8080
QINLIN_DB=data/qinlin.db
QINLIN_ADMIN_TOKEN=replace-with-at-least-32-random-characters
# Optional username/password login; use `go run ./cmd/qinlin admin set` to set both.
# QINLIN_ADMIN_USERNAME=admin
# QINLIN_ADMIN_PASSWORD_HASH=bcrypt:base64-encoded-bcrypt-hash
# Base64-encoded 32-byte AES key; retain this key when backing up the database.
QINLIN_ENCRYPTION_KEY=replace-with-base64-key
QINLIN_DEVICE_ID=replace-with-stable-random-device-id
QINLIN_COOLDOWN=5s
QINLIN_UPSTREAM_TIMEOUT=8s
QINLIN_MOCK=false
